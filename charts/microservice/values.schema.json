{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "microservice chart values",
  "description": "Rejects nulls, wrong types and unsafe defaults before anything reaches the cluster.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "replicaCount",
    "containerPort",
    "service",
    "probes",
    "resources"
  ],
  "properties": {
    "global": {
      "type": "object"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9./_-]+$"
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": [
              "latest"
            ]
          },
          "description": "Immutable tag (git SHA). 'latest' is rejected."
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "repository",
        "tag"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ]
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "containerPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "config": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "pattern": "^[A-Z_][A-Z0-9_]*$"
      },
      "description": "Every value must be a string. Quote numbers and booleans."
    },
    "secret": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "data": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "sealedSecret": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "encryptedData": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "existingSecretName": {
      "type": "string"
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          },
          "value": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "value"
        ]
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "portName": {
          "type": "string",
          "pattern": "^(http|http2|grpc|tcp)(-.*)?$"
        }
      },
      "additionalProperties": false,
      "required": [
        "port",
        "portName"
      ]
    },
    "probes": {
      "type": "object",
      "properties": {
        "liveness": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "path"
          ]
        },
        "readiness": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "path"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "liveness",
        "readiness"
      ]
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": [
                "string",
                "integer"
              ],
              "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi)?$"
            },
            "memory": {
              "type": [
                "string",
                "integer"
              ],
              "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi)?$"
            }
          },
          "additionalProperties": false,
          "required": [
            "cpu",
            "memory"
          ]
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": [
                "string",
                "integer"
              ],
              "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi)?$"
            },
            "memory": {
              "type": [
                "string",
                "integer"
              ],
              "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi)?$"
            }
          },
          "additionalProperties": false,
          "required": [
            "memory"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "requests",
        "limits"
      ]
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object",
      "properties": {
        "privileged": {
          "const": false
        },
        "allowPrivilegeEscalation": {
          "const": false
        }
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "pdb": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "strategy": {
      "type": "object",
      "properties": {
        "maxSurge": {
          "type": [
            "integer",
            "string"
          ]
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      },
      "additionalProperties": false
    },
    "istio": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "gateway": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "hosts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "timeout": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m)$"
        },
        "retries": {
          "type": "object",
          "properties": {
            "attempts": {
              "type": "integer",
              "minimum": 0
            },
            "perTryTimeout": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m)$"
            },
            "retryOn": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "outlierDetection": {
          "type": "object",
          "properties": {
            "consecutive5xxErrors": {
              "type": "integer",
              "minimum": 1
            },
            "interval": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m)$"
            },
            "baseEjectionTime": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m)$"
            }
          },
          "additionalProperties": false
        },
        "faultInjection": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "delay": {
              "type": "object",
              "properties": {
                "percentage": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "fixedDelay": {
                  "type": "string",
                  "pattern": "^[0-9]+(ms|s|m)$"
                }
              },
              "additionalProperties": false
            },
            "abort": {
              "type": "object",
              "properties": {
                "percentage": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "httpStatus": {
                  "type": "integer",
                  "minimum": 400,
                  "maximum": 599
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "canary": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "weight": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "imageTag": {
              "type": "string"
            },
            "replicaCount": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "authorizationPolicy": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "allowedServiceAccounts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "allowIngressGateway": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "helmTest": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}